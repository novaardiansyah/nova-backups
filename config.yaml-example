schedule:
  time: "23:59"

backup:
  destination: "/backup"
  sources:
    - name: "Projects"
      path: "/host/home/novaardiansyah/Projects"

    - name: "Documents"
      path: "/host/home/novaardiansyah/Documents"

  retention: 7

exclude:
  - "**/node_modules/"
  - "**/vendor/"
  - "**/.git/"
  - "**/.next/"
  - "**/dist/"
  - "**/build/"
  - "**/target/"
  - "**/__pycache__/"
  - "**/*.pyc"
