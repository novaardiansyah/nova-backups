schedule:
  time:
    - "10:00"
    - "15:00"

backup:
  destination: "/backup"
  sources:
    - source: "/host/home/novaardiansyah/Projects"
      target: "Projects"

    - source: "/host/home/novaardiansyah/Documents"
      target: "Documents"

  retention:
    local: 3
    cloud: 10

exclude:
  - "**/node_modules/"
  - "**/vendor/"
  - "**/.git/"
  - "**/.next/"
  - "**/dist/"
  - "**/build/"
  - "**/target/"
  - "**/__pycache__/"
  - "**/*.pyc"
